# Neo4j AuraDB
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# OpenAI
OPENAI_API_KEY=s

# LLM-Modus: "cloud" (OpenAI) oder "local" (LM Studio)
LLM_MODE=cloud

# LM Studio (nur relevant wenn LLM_MODE=local)
#LMSTUDIO_BASE_URL=http://localhost:1234/v1
#LMSTUDIO_CHAT_MODEL=local-model
#LMSTUDIO_VISION_MODEL=local-vision-model
#LMSTUDIO_EMBED_MODEL=nomic-embed-text
#LMSTUDIO_EMBED_DIM=768

# Websuche (openai / serp)
WEB_SEARCH_PROVIDER=openai
OPENAI_WEB_MODEL=gpt-4o-mini
SERPAPI_API_KEY=
MIN_SUPPORTS_COUNT=2
MIN_SUPPORTS_SCORE=0.15

# Ingestion
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=150

# Gamma API
GAMMA_API_KEY=s
GAMMA_API_URL=https://public-api.gamma.app/v0.2

# Synthesia API
SYNTHESIA_API_BASE=https://api.synthesia.io/v1
SYNTHESIA_API_KEY=