# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Websuche (openai / serp)
WEB_SEARCH_PROVIDER=openai
SERPAPI_API_KEY=

# LLM-Modus: "cloud" (OpenAI, Standard) oder "local" (LM Studio)
LLM_MODE=cloud

# LM Studio (nur relevant wenn LLM_MODE=local)
# LM Studio Local Server starten, dann Modellnamen exakt eintragen
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_CHAT_MODEL=mistral-7b-instruct
LMSTUDIO_VISION_MODEL=llava-v1.5-7b
LMSTUDIO_EMBED_MODEL=nomic-embed-text
LMSTUDIO_EMBED_DIM=768

# Ingestion
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=150

# Gamma API
GAMMA_API_KEY=sk-gamma-xxxxxxxx